<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Jornadasaludable\Administrator\Field">
    <fields name="filter">
        <field name="search" type="text" inputmode="search"
               label="COM_JORNADASALUDABLE_DOCUMENTO_FIELD_FICHERO"
               hint="JSEARCH_FILTER" filter="string"/>

        <field name="trabajador" type="Trabajador" onchange="this.form.submit();"
               label="COM_JORNADASALUDABLE_FILTER_TRABAJADOR">
            <option value="">- Todos -</option>
        </field>

        <field name="tipo" type="list" onchange="this.form.submit();"
               label="COM_JORNADASALUDABLE_FILTER_TIPO" default="">
            <option value="">- Todos -</option>
            <option value="REGISTRO_JORNADA_MENSUAL">Registro jornada mensual</option>
            <option value="RESUMEN_HORAS_EXTRA">Resumen horas extra</option>
            <option value="SOLICITUD_VACACIONES">Solicitud vacaciones</option>
            <option value="CERTIFICADO_DERECHOS">Certificado derechos</option>
            <option value="OTROS">Otros</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" default="a.created_at DESC" onchange="this.form.submit();">
            <option value="a.created_at DESC">Más recientes</option>
            <option value="a.created_at ASC">Más antiguos</option>
            <option value="a.tipo ASC">Tipo</option>
        </field>
        <field name="limit" type="limitbox" default="25" onchange="this.form.submit();" label="JGLOBAL_LIST_LIMIT"/>
    </fields>
</form>
