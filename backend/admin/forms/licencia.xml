<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Jornadasaludable\Administrator\Field">
    <fieldset name="datos">
        <field name="id" type="hidden" default="0"/>

        <field name="empresa_id" type="Empresa" required="true"
               label="COM_JORNADASALUDABLE_EMPRESA">
            <option value="">- Selecciona empresa -</option>
        </field>

        <field name="tipo" type="list" required="true" default="BASICA"
               label="COM_JORNADASALUDABLE_LICENCIA_FIELD_TIPO">
            <option value="BASICA">Básica</option>
            <option value="PROFESIONAL">Profesional</option>
            <option value="ENTERPRISE">Enterprise</option>
        </field>

        <field name="max_usuarios" type="number" default="10" min="1"
               label="COM_JORNADASALUDABLE_LICENCIA_FIELD_MAX_USUARIOS" filter="integer"/>

        <field name="fecha_inicio" type="calendar" format="%Y-%m-%d" required="true" todaybutton="true"
               label="COM_JORNADASALUDABLE_LICENCIA_FIELD_FECHA_INICIO" filter="user_utc"/>

        <field name="fecha_fin" type="calendar" format="%Y-%m-%d"
               label="COM_JORNADASALUDABLE_LICENCIA_FIELD_FECHA_FIN" filter="user_utc"/>

        <field name="activa" type="radio" layout="joomla.form.field.radio.switcher" default="1"
               label="COM_JORNADASALUDABLE_LICENCIA_FIELD_ACTIVA" filter="integer">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>
</form>
