<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Joomla\Component\Jornadasaludable\Administrator\Field">
    <fields name="filter">
        <field name="search" type="text" inputmode="search"
               label="COM_JORNADASALUDABLE_CENTRO_FIELD_NOMBRE"
               hint="JSEARCH_FILTER" filter="string"/>
        <field name="empresa" type="Empresa" onchange="this.form.submit();"
               label="COM_JORNADASALUDABLE_FILTER_EMPRESA">
            <option value="">- Todos -</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" default="a.nombre ASC" onchange="this.form.submit();">
            <option value="a.nombre ASC">Nombre A→Z</option>
            <option value="a.nombre DESC">Nombre Z→A</option>
            <option value="a.codigo ASC">Código A→Z</option>
        </field>
        <field name="limit" type="limitbox" default="25" onchange="this.form.submit();" label="JGLOBAL_LIST_LIMIT"/>
    </fields>
</form>
